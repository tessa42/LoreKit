{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /workspaces/LoreKit && npx tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /workspaces/LoreKit && grep -rn 'console\\.log\\|TODO\\|FIXME\\|: any' src/ --include='*.ts' --include='*.tsx' | grep -v '.next' | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Bash 명령 실행 전 확인: 위험한 명령(rm -rf, drop table 등)이 포함되어 있는지 검토하세요'"
          }
        ]
      }
    ]
  }
}
