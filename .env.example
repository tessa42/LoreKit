# Supabase — copy this file to .env and fill in your project values.
# Found at: https://supabase.com/dashboard → project → Settings → API
#
# These are VITE_ prefixed so Vite exposes them to the frontend bundle.
# The anon key is safe to expose publicly — RLS policies control access.
# NEVER put the service_role key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
